# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Every var here is NEXT_PUBLIC_* because the
# site is a static export with no server runtime, so nothing secret can live
# here. Never put a Stripe secret key (sk_...) in this file.
#
# IMPORTANT: these values are inlined at BUILD time. Changing one requires
# `npm run build` and a redeploy before it takes effect.
# ---------------------------------------------------------------------------

# --- Stripe -----------------------------------------------------------------
# A Stripe Payment Link for the $499 template offer, created in the Stripe
# dashboard once the business is registered. Leave EMPTY until then: the
# template pages automatically fall back to the "request a brief" flow and
# show "Online checkout coming soon".
# Example: https://buy.stripe.com/test_xxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# --- Firebase ---------------------------------------------------------------
# From Firebase console > Project settings > Your apps > Web app config.
# These are publishable by design; access is controlled by Firestore rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# reCAPTCHA v3 site key for Firebase App Check. Free. Without it, App Check is
# disabled and the Firestore rules must not require it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Optional email relay ---------------------------------------------------
# Cloud Functions need the paid Blaze plan, so lead emails go through a free
# relay instead (Web3Forms, Formspree, etc). Leave empty to skip email
# entirely; leads still land in Firestore and can be read in the console.
NEXT_PUBLIC_FORM_RELAY_ENDPOINT=
# Web3Forms only: the public access key (created at web3forms.com for the
# receiving @nowmagnate.com address). Set the endpoint to
# https://api.web3forms.com/submit. Leave empty for Formspree, whose endpoint
# URL already identifies the form.
NEXT_PUBLIC_FORM_RELAY_ACCESS_KEY=

# --- Analytics (optional) ---------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Site ------------------------------------------------------------------
# Canonical origin, used for sitemap, robots and absolute OG image URLs.
NEXT_PUBLIC_SITE_URL=https://nowmagnate.com
