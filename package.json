{
  "name": "nowmagnate-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit-copy.mjs",
    "check:contrast": "node scripts/check-template-contrast.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "check:type": "node scripts/check-typography.mjs",
    "verify": "npm run typecheck && npm run lint && npm run audit && npm run check:contrast && npm run check:type && npm run check:templates && npm run check:payments && npm run test:payments",
    "check:payments": "node scripts/check-payments-sync.mjs",
    "test:payments": "node --test \"workers/payments/test/*.test.ts\""
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "clsx": "^2.1.1",
    "firebase": "^11.1.0",
    "gray-matter": "^4.0.3",
    "motion": "^11.15.0",
    "next": "^15.1.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
